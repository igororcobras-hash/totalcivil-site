rules_version = '2';

// Regras de segurança do Firestore — Total Civil (todos os programas)
// Cole este conteúdo em: Firebase › Firestore Database › Regras › Publicar.
//
// O que estas regras garantem, no servidor (não dá para burlar pelo navegador):
//   1. Um único cadastro por pessoa para todos os programas.
//   2. Só os administradores liberam programas, definem validade e veem todos os cadastros.
//   3. Ninguém se promove a administrador nem se libera sozinho.
//   4. O próprio usuário só pode fazer pedidos (programas, forma de pagamento, aviso de pagamento).
//   5. Pedidos de programa personalizado: qualquer visitante envia; só o administrador lê.
//   6. Pagamentos recebidos: só os administradores registram e consultam.

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // Administradores: lista fixa, conferida no servidor (igual à do firebase-config.js).
    function admin() {
      return logado() && request.auth.token.email in [
        'wfajardoeng@gmail.com',
        'igororcobras@gmail.com'
      ];
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function temPerfil() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // Licença do Pavimento Flexível (projetos na nuvem): ativo e dentro da validade.
    function liberado() {
      return admin() || (
        logado() && temPerfil() &&
        perfil().ativo == true &&
        (perfil().validade == null || perfil().validade > request.time)
      );
    }

    // Obra liberada para esta pessoa pelo administrador (manutencaoObras: {idDoDocumento: 'gestor'|'fiscal'|'empresa'}).
    function membroObra(docId) {
      return logado() && temPerfil() &&
        perfil().get('manutencaoObras', {}).get(docId, '') in ['gestor', 'fiscal', 'empresa'];
    }

    // Programa com liberação própria (campo do painel Usuários): administrador, ou
    // campo = true, sem recusa e dentro da validade.
    function liberadoPrograma(campo) {
      return admin() || (
        logado() && temPerfil() &&
        perfil()[campo] == true &&
        perfil().recusado != true &&
        (perfil().validade == null || perfil().validade > request.time)
      );
    }

    function falsoOuAusente(d, campo) {
      return !(campo in d) || d[campo] == false;
    }

    match /usuarios/{uid} {
      // Cada um lê o próprio cadastro; o administrador lê todos.
      allow read: if logado() && (uid == request.auth.uid || admin());

      // Cadastro novo: o próprio usuário cria seu perfil, sempre sem nenhum programa liberado.
      allow create: if logado()
                    && uid == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'usuario','email','nome','empresa','whatsapp',
                         'ativo','admin','recusado','validade','criadoEm',
                         'orcamentoSolicitado','orcamentoAtivo','intertravadoSolicitado','intertravadoAtivo',
                         'drenagemSolicitado','drenagemAtivo','estruturaAtivo','visitasSolicitado','visitasAtivo','manutencaoSolicitado','manutencaoAtivo',
                         'programasPedidos','formaPagamento','plano','tipoPedido','pedidoEm','indicadoPor'])
                    && request.resource.data.ativo == false
                    && request.resource.data.admin == false
                    && request.resource.data.recusado == false
                    && request.resource.data.validade == null
                    && falsoOuAusente(request.resource.data, 'orcamentoAtivo')
                    && falsoOuAusente(request.resource.data, 'intertravadoAtivo')
                    && falsoOuAusente(request.resource.data, 'drenagemAtivo')
                    && falsoOuAusente(request.resource.data, 'estruturaAtivo')
                    && falsoOuAusente(request.resource.data, 'visitasAtivo')
                    && falsoOuAusente(request.resource.data, 'manutencaoAtivo')
                    && request.resource.data.email == request.auth.token.email;

      // Liberar programas, validade, recusa: somente administrador.
      // O próprio usuário pode apenas fazer pedidos e avisar o pagamento.
      allow update: if admin()
                    || (logado() && uid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'orcamentoSolicitado','intertravadoSolicitado','drenagemSolicitado','visitasSolicitado','manutencaoSolicitado',
                             'programasPedidos','formaPagamento','plano','tipoPedido','pedidoEm','indicadoPor','pagamentoAvisadoEm'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['orcamentoSolicitado'])
                            || request.resource.data.orcamentoSolicitado == true)
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['intertravadoSolicitado'])
                            || request.resource.data.intertravadoSolicitado == true)
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['drenagemSolicitado'])
                            || request.resource.data.drenagemSolicitado == true)
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['visitasSolicitado'])
                            || request.resource.data.visitasSolicitado == true)
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['manutencaoSolicitado'])
                            || request.resource.data.manutencaoSolicitado == true));
      allow delete: if admin();
    }

    // Apelido -> e-mail (login do Orçamento com apelido).
    match /apelidos/{apelido} {
      allow get: if true;
      allow list: if false;
      allow create: if logado()
                    && request.resource.data.keys().hasOnly(['email','uid','criadoEm'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.email;
      allow update, delete: if admin();
    }

    // Projetos salvos na nuvem (Pavimento Flexível).
    match /projetos/{projetoId} {
      allow read: if liberado()
                  && (resource.data.uid == request.auth.uid || admin());
      allow create: if liberado()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if liberado()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if liberado()
                    && (resource.data.uid == request.auth.uid || admin());
    }

    // Obras do programa Serviços Públicos salvas na nuvem (sem as fotos).
    // Cada obra é do dono (quem a criou) e do administrador; os demais só entram se o
    // administrador liberar a obra no cadastro da pessoa (campo manutencaoObras: {idDoDocumento: perfil}).
    match /obrasServicos/{docId} {
      allow read: if liberadoPrograma('manutencaoAtivo')
                  && (resource.data.uid == request.auth.uid || admin() || membroObra(docId));
      allow create: if liberadoPrograma('manutencaoAtivo')
                    && request.resource.data.uid == request.auth.uid
                    && docId == request.auth.uid + '_' + request.resource.data.obraId;
      allow update: if liberadoPrograma('manutencaoAtivo')
                    && (resource.data.uid == request.auth.uid || admin() || membroObra(docId))
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.obraId == resource.data.obraId;
      allow delete: if liberadoPrograma('manutencaoAtivo')
                    && (resource.data.uid == request.auth.uid || admin());
    }

    // Fotos das obras de Serviços Públicos (JPEG reduzido, ≈100–150 KB cada): mesmas pessoas da obra.
    // O documento guarda obraDoc = idDoDono_idDaObra, que decide quem pode ler.
    match /fotosServicos/{fotoId} {
      allow read: if liberadoPrograma('manutencaoAtivo')
                  && (resource.data.uid == request.auth.uid || admin() || membroObra(resource.data.obraDoc));
      allow create: if liberadoPrograma('manutencaoAtivo')
                    && request.resource.data.obraDoc == request.resource.data.uid + '_' + request.resource.data.obraId
                    && request.resource.data.dados is string
                    && request.resource.data.dados.size() < 900000
                    && (request.resource.data.uid == request.auth.uid || admin() || membroObra(request.resource.data.obraDoc));
      allow update: if false;
      allow delete: if liberadoPrograma('manutencaoAtivo')
                    && (resource.data.uid == request.auth.uid || admin() || membroObra(resource.data.obraDoc));
    }

    // Pedidos de programa personalizado (quadro da página principal).
    match /solicitacoes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nome','contato','email','descricao','uid','criadoEm'])
                    && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
                    && request.resource.data.contato is string && request.resource.data.contato.size() <= 30
                    && request.resource.data.email is string && request.resource.data.email.size() <= 120
                    && request.resource.data.descricao is string && request.resource.data.descricao.size() <= 3000;
      allow read, delete: if admin();
      allow update: if false;
    }

    // Pagamentos recebidos (relatório): somente administradores.
    // Registro permanente: ninguém edita nem apaga, e cada lançamento leva o e-mail
    // de quem está logado (um administrador não consegue lançar em nome do outro).
    match /pagamentos/{id} {
      allow read: if admin();
      allow create: if admin()
                    && request.resource.data.registradoPor == request.auth.token.email
                    && request.resource.data.criadoEm == request.time
                    && request.resource.data.valor is number && request.resource.data.valor >= 0;
      allow update, delete: if false;
    }

    // Código dos programas (gravado só pela publicação automática, com conta de serviço).
    // Entregue apenas a quem tem o programa liberado: mesmo campo, recusa e validade
    // do painel Usuários. A lista abaixo precisa ser igual à de scripts/publicar/montar-site.js.
    function campoDoPrograma(prog) {
      return {
        'pavimento': 'ativo',
        'orcamento': 'orcamentoAtivo',
        'intertravado': 'intertravadoAtivo',
        'drenagem': 'drenagemAtivo',
        'concreto': 'estruturaAtivo',
        'visitas': 'visitasAtivo',
        'manutencao': 'manutencaoAtivo'
      }.get(prog, '');
    }
    function podeUsar(prog) {
      return admin() || (
        logado() && temPerfil() && campoDoPrograma(prog) != '' &&
        perfil().get(campoDoPrograma(prog), false) == true &&
        perfil().get('recusado', false) != true &&
        (perfil().get('validade', null) == null || perfil().validade > request.time)
      );
    }
    match /programas/{prog} {
      allow get: if podeUsar(prog);
      allow list, write: if false;
      match /partes/{parte} {
        allow get: if podeUsar(prog);
        allow list, write: if false;
      }
    }

    // Projetos da Drenagem Pluvial salvos na nuvem: só o dono (com a Drenagem liberada) lê e grava; o administrador lê e exclui.
    // A lista é feita só por uid (sem índice composto); o tamanho de cada projeto é limitado a ~1 MB pelo próprio Firestore.
    match /projetosDrenagem/{projetoId} {
      allow read: if podeUsar('drenagem')
                  && (resource.data.uid == request.auth.uid || admin());
      allow create: if podeUsar('drenagem')
                    && request.resource.data.uid == request.auth.uid;
      allow update: if podeUsar('drenagem')
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if podeUsar('drenagem')
                    && (resource.data.uid == request.auth.uid || admin());
    }

    // Qualquer outro caminho fica bloqueado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
